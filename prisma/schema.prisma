generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ResortStaffStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ResortTimeLogFlag {
  ON_TIME
  LATE
  ABSENT
}

enum ResortScheduleShiftStatus {
  ASSIGNED
  OPEN
  CHANGED
}

enum ResortLeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResortOtUndertimeType {
  OVERTIME
  UNDERTIME
}

enum ResortOtUndertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResortPayrollRunStatus {
  DRAFT
  COMPLETED
  VOIDED
}

enum ResortPayrollPaymentStatus {
  UNPAID
  PAID
}

enum ResortPayrollPayType {
  REGULAR
  FINAL
}

enum ResortPayrollFrequency {
  MONTHLY
  BI_WEEKLY
}

enum ResortStaffInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ResortDepartmentStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ResortAmenityStatus {
  ACTIVE
  INACTIVE
}

enum ResortAmenityScope {
  ROOM_LEVEL
  PROPERTY_LEVEL
}

enum ResortAmenityFeeUnit {
  PER_STAY
  PER_DAY
  PER_USE
}

enum ResortRoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ResortHousekeepingStatus {
  CLEAN
  DIRTY
  OCCUPIED
  VACANT
}

enum ResortHousekeepingDamageStatus {
  OPEN
  RESOLVED
}

enum ResortLaundryStatus {
  RECEIVED
  WASHING
  DRYING
  READY
  RETURNED
}

enum ResortLaundryPriority {
  NORMAL
  URGENT
}

enum ResortRoomSmokingPolicy {
  NON_SMOKING
  SMOKING
}

enum ResortReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELED
}

enum ResortReceptionQueueStatus {
  ARRIVING
  IN_HOUSE
  CHECKING_OUT
  COMPLETED
}

enum ResortReceptionRequestPriority {
  NORMAL
  URGENT
}

enum ResortReceptionRequestStatus {
  OPEN
  SENT
  RESOLVED
}

enum ResortMaintenancePriority {
  NORMAL
  URGENT
}

enum ResortMaintenanceRequestStatus {
  PENDING
  COMPLETED
}

enum ResortInventoryMovementType {
  IN
  OUT
}

enum ResortServiceStatus {
  ACTIVE
  INACTIVE
}

enum ResortPackageStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ResortServiceBillingType {
  FIXED_PRICE
  PER_HOUR
  PER_GUEST
  CUSTOM_QUOTE
}

enum ResortInvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum ResortFolioChargeStatus {
  UNBILLED
  INVOICED
  VOIDED
  ADJUSTED
}

enum ResortFolioChargeType {
  STAY
  ADDITIONAL
  FEE
  ADJUSTMENT
}

enum ResortPaymentLogStatus {
  RECORDED
  VOIDED
}

enum ResortInvoiceReminderCadence {
  STANDARD
  LIGHT
  STRICT
  PAUSED
}

enum ResortFinanceEntryType {
  REVENUE
  EXPENSE
}

enum ResortFinanceEntrySource {
  MANUAL
  AUTO_BOOKING
  INVOICE_PAYMENT
}

enum ResortFinanceEntryStatus {
  CLEARED
  PENDING
}

enum ResortTransactionExportFormat {
  CSV
  PDF
  TXT
  XLSX
}

enum ResortTransactionExportStatus {
  READY
  SCHEDULED
  FAILED
}

enum ResortLeadStage {
  INTAKE
  QUALIFIED
  PAYMENT_DONE
  CONVERTED
}

enum ResortLeadChannel {
  MESSENGER
}

enum ResortLeadMessageDirection {
  INBOUND
  OUTBOUND
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  appUser       AppUser?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model AppUser {
  authUserId        String              @id
  email             String              @unique
  firstName         String?
  lastName          String?
  displayName       String
  guestProfile      Json                @default("{}")
  guestDisabledAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  authUser          User                @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  resortProfile     ResortProfile?
  staffProfile      ResortStaffProfile?
  guestReservations ResortReservation[] @relation("RegisteredGuestReservations")
  // customerProfile CustomerProfile?

  @@map("app_user")
}

model ResortProfile {
  id                        String                           @id @default(cuid())
  appUserId                 String                           @unique
  resortName                String                           @default("Alrio Private Resort")
  propertyType              String?
  fullAddress               String?
  region                    String?
  province                  String?
  municipality              String?
  barangay                  String?
  phoneNumber               String?
  website                   String?
  shortDescription          String?
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  appUser                   AppUser                          @relation(fields: [appUserId], references: [authUserId], onDelete: Cascade)
  departments               ResortDepartment[]
  amenities                 ResortAmenity[]
  rooms                     ResortRoom[]
  reservations              ResortReservation[]
  services                  ResortService[]
  packages                  ResortPackage[]
  invoices                  ResortInvoice[]
  financeEntries            ResortFinanceEntry[]
  transactionExports        ResortTransactionExport[]
  messengerIntegrations     ResortMessengerIntegration[]
  leads                     ResortLead[]
  contactInquiries          ResortContactInquiry[]
  folioCharges              ResortFolioCharge[]
  paymentLogs               ResortPaymentLog[]
  paymentCheckouts          ResortPaymentCheckout[]
  receptionRequests         ResortReceptionRequest[]
  receptionShiftNotes       ResortReceptionShiftNote[]
  maintenanceRequests       ResortMaintenanceRequest[]
  inventoryItems            ResortInventoryItem[]
  inventoryMovements        ResortInventoryMovement[]
  housekeepingRooms         ResortHousekeepingRoom[]
  housekeepingDamageReports ResortHousekeepingDamageReport[]
  laundryJobs               ResortLaundryJob[]
  staffProfiles             ResortStaffProfile[]
  accessRoles               ResortAccessRole[]
  staffInvitations          ResortStaffInvitation[]
  timeLogs                  ResortTimeLog[]
  scheduleShifts            ResortScheduleShift[]
  leaveRequests             ResortLeaveRequest[]
  leavePolicies             ResortLeavePolicy[]
  leaveBalances             ResortLeaveBalance[]
  otUndertimeEntries        ResortOtUndertimeEntry[]
  payrollRuns               ResortPayrollRun[]
  payrollItems              ResortPayrollItem[]
  staffActivityLogs         ResortStaffActivityLog[]
  developerSettings         ResortDeveloperSetting[]
  landingBranding           ResortLandingBranding?

  @@map("resort_profile")
}

model ResortDeveloperSetting {
  id                   String        @id @default(cuid())
  resortProfileId      String
  key                  String
  encryptedValue       String
  initializationVector String
  authenticationTag    String
  updatedByAuthUserId  String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  resortProfile        ResortProfile @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)

  @@unique([resortProfileId, key])
  @@index([resortProfileId])
  @@map("resort_developer_setting")
}

model ResortLandingBranding {
  id                  String        @id @default(cuid())
  resortProfileId     String        @unique
  content             Json
  updatedByAuthUserId String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  resortProfile       ResortProfile @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)

  @@map("resort_landing_branding")
}

model ResortContactInquiry {
  id              String        @id @default(cuid())
  resortProfileId String
  name            String
  email           String
  phone           String?
  subject         String
  message         String
  createdAt       DateTime      @default(now())
  resortProfile   ResortProfile @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)

  @@index([resortProfileId, createdAt])
  @@index([email, createdAt])
  @@map("resort_contact_inquiry")
}

model ResortMessengerIntegration {
  id               String        @id @default(cuid())
  resortProfileId  String
  pageId           String        @unique
  pageName         String?
  pageAccessToken  String?
  verifyToken      String?
  subscribedFields String[]      @default([])
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  resortProfile    ResortProfile @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)
  leads            ResortLead[]

  @@index([resortProfileId])
  @@index([isActive])
  @@map("resort_messenger_integration")
}

model ResortLead {
  id                     String                      @id @default(cuid())
  resortProfileId        String
  messengerIntegrationId String?
  reservationId          String?
  psid                   String
  channel                ResortLeadChannel           @default(MESSENGER)
  guestName              String                      @default("Messenger guest")
  profilePictureUrl      String?
  inquiry                String?
  lastMessage            String?
  source                 String                      @default("Organic")
  stage                  ResortLeadStage             @default(INTAKE)
  targetDate             DateTime?
  lastMessageAt          DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  resortProfile          ResortProfile               @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)
  messengerIntegration   ResortMessengerIntegration? @relation(fields: [messengerIntegrationId], references: [id], onDelete: SetNull)
  reservation            ResortReservation?          @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  messages               ResortLeadMessage[]

  @@unique([resortProfileId, psid])
  @@index([resortProfileId])
  @@index([messengerIntegrationId])
  @@index([reservationId])
  @@index([stage])
  @@index([lastMessageAt])
  @@map("resort_lead")
}

model ResortLeadMessage {
  id              String                     @id @default(cuid())
  resortLeadId    String
  metaMessageId   String?                    @unique
  senderId        String
  recipientId     String
  direction       ResortLeadMessageDirection @default(INBOUND)
  text            String?
  attachments     Json?
  postbackPayload String?
  raw             Json?
  sentAt          DateTime
  createdAt       DateTime                   @default(now())
  lead            ResortLead                 @relation(fields: [resortLeadId], references: [id], onDelete: Cascade)

  @@index([resortLeadId])
  @@index([senderId])
  @@index([recipientId])
  @@index([sentAt])
  @@map("resort_lead_message")
}

model ResortStaffProfile {
  id                     String                   @id @default(cuid())
  resortProfileId        String
  appUserId              String                   @unique
  accessRoleId           String
  departmentId           String?
  username               String?                  @unique
  phoneNumber            String?
  status                 ResortStaffStatus        @default(INVITED)
  isDepartmentHead       Boolean                  @default(false)
  employmentType         String                   @default("Regular")
  workLocation           String                   @default("Resort Office")
  basicSalary            Decimal                  @default(0) @db.Decimal(12, 2)
  allowance              Decimal                  @default(0) @db.Decimal(12, 2)
  incentives             Decimal                  @default(0) @db.Decimal(12, 2)
  commission             Decimal                  @default(0) @db.Decimal(12, 2)
  bonus                  Decimal                  @default(0) @db.Decimal(12, 2)
  leaveDeduction         Decimal                  @default(0) @db.Decimal(12, 2)
  sssContribution        Decimal                  @default(0) @db.Decimal(12, 2)
  philHealthContribution Decimal                  @default(0) @db.Decimal(12, 2)
  pagIbigContribution    Decimal                  @default(0) @db.Decimal(12, 2)
  withholdingTax         Decimal                  @default(0) @db.Decimal(12, 2)
  otherDeductions        Decimal                  @default(0) @db.Decimal(12, 2)
  notes                  String?
  tags                   String[]                 @default([])
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  resortProfile          ResortProfile            @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)
  accessRole             ResortAccessRole         @relation(fields: [accessRoleId], references: [id], onDelete: Restrict)
  department             ResortDepartment?        @relation("ResortDepartmentStaff", fields: [departmentId], references: [id], onDelete: SetNull)
  headOfDepartment       ResortDepartment?        @relation("ResortDepartmentHead")
  appUser                AppUser                  @relation(fields: [appUserId], references: [authUserId], onDelete: Cascade)
  housekeepingRooms      ResortHousekeepingRoom[]
  timeLogs               ResortTimeLog[]
  scheduleShifts         ResortScheduleShift[]
  leaveRequests          ResortLeaveRequest[]
  leaveBalances          ResortLeaveBalance[]
  otUndertimeEntries     ResortOtUndertimeEntry[]
  payrollItems           ResortPayrollItem[]
  activityLogs           ResortStaffActivityLog[]

  @@index([resortProfileId])
  @@index([accessRoleId])
  @@index([departmentId])
  @@index([status])
  @@map("resort_staff_profile")
}

model ResortStaffActivityLog {
  id              String             @id @default(cuid())
  resortProfileId String
  staffProfileId  String
  actorAuthUserId String?
  action          String
  title           String
  detail          String
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  createdAt       DateTime           @default(now())
  resortProfile   ResortProfile      @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)
  staffProfile    ResortStaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([staffProfileId, createdAt])
  @@index([resortProfileId, createdAt])
  @@map("resort_staff_activity_log")
}

model ResortAccessRole {
  id              String               @id @default(cuid())
  resortProfileId String
  name            String
  description     String?
  permissions     String[]             @default([])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  resortProfile   ResortProfile        @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)
  staffProfiles   ResortStaffProfile[]

  @@unique([resortProfileId, name])
  @@index([resortProfileId])
  @@map("resort_access_role")
}

model ResortTimeLog {
  id              String             @id @default(cuid())
  resortProfileId String
  staffProfileId  String
  date            DateTime
  clockIn         DateTime?
  clockOut        DateTime?
  flag            ResortTimeLogFlag  @default(ON_TIME)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  resortProfile   ResortProfile      @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)
  staffProfile    ResortStaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, date])
  @@index([resortProfileId])
  @@index([staffProfileId])
  @@index([date])
  @@index([flag])
  @@map("resort_time_log")
}

model ResortScheduleShift {
  id              String                    @id @default(cuid())
  resortProfileId String
  staffProfileId  String?
  shift           String
  role            String
  department      String?
  startAt         DateTime
  endAt           DateTime
  status          ResortScheduleShiftStatus @default(ASSIGNED)
  notes           String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  resortProfile   ResortProfile             @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)
  staffProfile    ResortStaffProfile?       @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)

  @@index([resortProfileId])
  @@index([staffProfileId])
  @@index([startAt])
  @@index([status])
  @@map("resort_schedule_shift")
}

model ResortLeaveRequest {
  id              String                   @id @default(cuid())
  resortProfileId String
  staffProfileId  String
  leaveType       String
  startDate       DateTime
  endDate         DateTime
  reason          String
  balanceDays     Int                      @default(0)
  leavePolicyId   String?
  status          ResortLeaveRequestStatus @default(PENDING)
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  resortProfile   ResortProfile            @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)
  staffProfile    ResortStaffProfile       @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  leavePolicy     ResortLeavePolicy?       @relation(fields: [leavePolicyId], references: [id], onDelete: SetNull)

  @@index([resortProfileId])
  @@index([staffProfileId])
  @@index([status])
  @@index([startDate])
  @@index([leavePolicyId])
  @@map("resort_leave_request")
}

model ResortLeavePolicy {
  id                String               @id @default(cuid())
  resortProfileId   String
  name              String
  annualEntitlement Int                  @default(0)
  carryOverLimit    Int                  @default(0)
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  resortProfile     ResortProfile        @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)
  balances          ResortLeaveBalance[]
  leaveRequests     ResortLeaveRequest[]

  @@unique([resortProfileId, name])
  @@index([resortProfileId, isActive])
  @@map("resort_leave_policy")
}

model ResortLeaveBalance {
  id              String             @id @default(cuid())
  resortProfileId String
  staffProfileId  String
  leavePolicyId   String
  year            Int
  openingDays     Int                @default(0)
  allocatedDays   Int                @default(0)
  adjustmentDays  Int                @default(0)
  usedDays        Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  resortProfile   ResortProfile      @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)
  staffProfile    ResortStaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  leavePolicy     ResortLeavePolicy  @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, leavePolicyId, year])
  @@index([resortProfileId, year])
  @@index([leavePolicyId])
  @@map("resort_leave_balance")
}

model ResortOtUndertimeEntry {
  id              String                  @id @default(cuid())
  resortProfileId String
  staffProfileId  String
  type            ResortOtUndertimeType
  hours           String
  payPeriod       String
  reason          String
  status          ResortOtUndertimeStatus @default(PENDING)
  reviewedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  resortProfile   ResortProfile           @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)
  staffProfile    ResortStaffProfile      @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([resortProfileId])
  @@index([staffProfileId])
  @@index([type])
  @@index([status])
  @@map("resort_ot_undertime_entry")
}

model ResortPayrollRun {
  id                        String                 @id @default(cuid())
  resortProfileId           String
  code                      String
  name                      String
  payPeriod                 String
  periodStart               DateTime
  periodEnd                 DateTime
  payDate                   DateTime
  payType                   ResortPayrollPayType   @default(REGULAR)
  frequency                 ResortPayrollFrequency @default(MONTHLY)
  department                String?
  notes                     String?
  status                    ResortPayrollRunStatus @default(DRAFT)
  totalEmployees            Int                    @default(0)
  includedEmployees         Int                    @default(0)
  excludedEmployees         Int                    @default(0)
  totalBasicSalary          Decimal                @default(0) @db.Decimal(12, 2)
  totalAllowances           Decimal                @default(0) @db.Decimal(12, 2)
  totalIncentives           Decimal                @default(0) @db.Decimal(12, 2)
  totalCommission           Decimal                @default(0) @db.Decimal(12, 2)
  totalBonus                Decimal                @default(0) @db.Decimal(12, 2)
  totalOvertimePay          Decimal                @default(0) @db.Decimal(12, 2)
  totalGrossPay             Decimal                @default(0) @db.Decimal(12, 2)
  totalLeaveDeductions      Decimal                @default(0) @db.Decimal(12, 2)
  totalUndertimeDeductions  Decimal                @default(0) @db.Decimal(12, 2)
  totalGovernmentDeductions Decimal                @default(0) @db.Decimal(12, 2)
  totalOtherDeductions      Decimal                @default(0) @db.Decimal(12, 2)
  totalDeductions           Decimal                @default(0) @db.Decimal(12, 2)
  totalNetPay               Decimal                @default(0) @db.Decimal(12, 2)
  employerContributions     Decimal                @default(0) @db.Decimal(12, 2)
  employerCost              Decimal                @default(0) @db.Decimal(12, 2)
  options                   Json?
  backupSnapshot            Json?
  lockedAt                  DateTime?
  lockedBy                  String?
  finalizedAt               DateTime?
  finalizedBy               String?
  payslipNotifiedAt         DateTime?
  paymentStatus             ResortPayrollPaymentStatus @default(UNPAID)
  paidAt                    DateTime?
  paidBy                    String?
  paymentMethod             String?
  paymentReference          String?
  journalEntryId            String?
  generatedBy               String?
  generatedAt               DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  resortProfile             ResortProfile          @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)
  items                     ResortPayrollItem[]

  @@unique([resortProfileId, code])
  @@index([resortProfileId])
  @@index([periodStart])
  @@index([status])
  @@index([paymentStatus])
  @@map("resort_payroll_run")
}

model ResortPayrollItem {
  id                   String             @id @default(cuid())
  payrollRunId         String
  resortProfileId      String
  staffProfileId       String
  employeeName         String
  employeeCode         String
  roleName             String?
  departmentName       String?
  employmentType       String?
  workLocation         String?
  daysWorked           Int                @default(0)
  lateCount            Int                @default(0)
  absentCount          Int                @default(0)
  leaveDays            Int                @default(0)
  regularHours         Decimal            @default(0) @db.Decimal(8, 2)
  overtimeHours        Decimal            @default(0) @db.Decimal(8, 2)
  undertimeHours       Decimal            @default(0) @db.Decimal(8, 2)
  basicSalary          Decimal            @default(0) @db.Decimal(12, 2)
  allowance            Decimal            @default(0) @db.Decimal(12, 2)
  incentives           Decimal            @default(0) @db.Decimal(12, 2)
  commission           Decimal            @default(0) @db.Decimal(12, 2)
  bonus                Decimal            @default(0) @db.Decimal(12, 2)
  overtimePay          Decimal            @default(0) @db.Decimal(12, 2)
  grossPay             Decimal            @default(0) @db.Decimal(12, 2)
  leaveDeduction       Decimal            @default(0) @db.Decimal(12, 2)
  undertimeDeduction   Decimal            @default(0) @db.Decimal(12, 2)
  governmentDeductions Decimal            @default(0) @db.Decimal(12, 2)
  otherDeductions      Decimal            @default(0) @db.Decimal(12, 2)
  totalDeductions      Decimal            @default(0) @db.Decimal(12, 2)
  netPay               Decimal            @default(0) @db.Decimal(12, 2)
  included             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  payrollRun           ResortPayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  resortProfile        ResortProfile      @relation(fields: [resortProfileId], references: [id], onDelete: Cascade)
  staffProfile         ResortStaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, staffProfileId])
  @@index([resortProfileId])
  @@index([staffProfileId])
  @@map("resort_payroll_item")
}

model ResortDepartment {
  id                 String                 @id @default(cuid())
  resortProfileId    String
  name               String
  code               String
  description        String?
  email              String?
  notes              String?
  routing            String?
  status             ResortDepartmentStatus @default(ACTIVE)
  headStaffProfileId String?                @unique
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
